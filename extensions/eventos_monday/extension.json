{
  "id": "eventos_monday",
  "module": "eventos",
  "displayName": "Importacion de eventos desde monday",
  "description": "Importa un tablero de monday (por ejemplo Vista Mar Eventos) como eventos privados: lee el tablero con el token de la empresa, mapea sus columnas y crea el evento y su cliente por cada elemento.",
  "version": "1.1.0",
  "minModuleVersion": "0.3.0",
  "source": { "type": "github", "url": "https://github.com/alexcalbri/bms/tree/0000000000000000000000000000000000000000/extensions/eventos_monday" },
  "permissions": [
    "network.outbound:api.monday.com",
    "secrets.write",
    "eventos.import.write"
  ],
  "settings": [],
  "migrations": ["migrations/V001__settings.sql", "migrations/V002__rendimiento.sql"],
  "uninstall": { "options": [
    { "id": "import_history", "label": "Historial de importaciones de monday", "default": "delete" }
  ] }
}
