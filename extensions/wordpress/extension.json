{
  "id": "wordpress",
  "module": "crm",
  "displayName": "WordPress (Real Estate 7)",
  "description": "Conecta el sitio WordPress (Real Estate 7) con el plugin BMS Connector: formularios y consultas crean leads, y las propiedades se buscan y se vinculan a ellos.",
  "version": "1.1.0",
  "minModuleVersion": "0.30.0",
  "source": { "type": "github", "url": "https://github.com/alexcalbri/bms/tree/0000000000000000000000000000000000000000/extensions/wordpress" },
  "permissions": [
    "secrets.write",
    "webhook.public",
    "crm.leads.create",
    "crm.leads.update",
    "crm.items.write"
  ],
  "settings": [],
  "migrations": ["migrations/V001__settings.sql"],
  "uninstall": { "options": [
    { "id": "linked_properties", "label": "Propiedades del sitio vinculadas a los leads", "default": "keep" }
  ] }
}
